# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/letschat
# Atlas:  mongodb+srv://<username>:<password>@<cluster-url>/letschat?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/letschat

# Any long random string (used to sign JWT login tokens)
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the backend server will run on
PORT=5000

# URL of the frontend (used for CORS + socket.io)
CLIENT_URL=http://localhost:5173
